<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Client SignalR : vérification du backplane Redis entre deux instances (10.0.13 : correctif CVE-2026-70159). -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.13" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Redis jetable (Testcontainers) ; Garage (S3) via le conteneur générique, voir Outils/ServeursAnnexesTests.cs. -->
    <PackageReference Include="Testcontainers.Redis" Version="4.16.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="MimeKit" Version="4.18.1" />
    <!-- Serveur PostgreSQL jetable (Docker) pour les tests : une base dédiée par classe de tests. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <!-- Dépendance transitive de Testcontainers (10.0.0 signalée vulnérable) : version corrigée imposée. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ImmoPlus.Api/ImmoPlus.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
