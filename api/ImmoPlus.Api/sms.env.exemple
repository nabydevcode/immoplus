# Vrais SMS via un téléphone Android (application « SMS Gateway for Android », mode serveur local).
# Copier ce fichier en sms.env (non versionné), remplir, puis : docker compose up -d api
Sms__Mode=PasserelleAndroid
# Adresse affichée par l'application (même Wi-Fi que le Mac), sans barre finale.
Sms__Passerelle__Url=http://192.168.1.XX:8080
Sms__Passerelle__Utilisateur=sms
Sms__Passerelle__MotDePasse=a-remplir
# Sécurité pendant les tests : seuls ces numéros reçoivent un vrai SMS (les autres sont seulement tracés).
Sms__NumerosAutorises__0=+224620000000
# Sms__NumerosAutorises__1=+224660000000
# Sms__EnvoyerATous=false
