<Project Sdk="Microsoft.NET.Sdk">

  <!-- Outil ponctuel et rejouable : copie des fichiers de Storage/ vers le bucket S3 (Garage), avec contrôle SHA-256. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Même client S3 que l'API (licence Apache-2.0). -->
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.4" />
  </ItemGroup>

</Project>
