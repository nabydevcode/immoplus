@page "/reservation/{Id:int}"
@inject HttpClient Http
@inject AuthServices AuthSvc

<PageTitle>Réservation - ImmoPlus</PageTitle>

<div class="bg-immo-cream min-h-screen px-6 py-8 flex justify-center">
    <div class="w-full max-w-xl">
        @if (chargement)
        {
            <p>Chargement...</p>
        }
        else if (erreur is not null)
        {
            <p class="text-red-600">@erreur</p>
        }
        else if (reservation is not null)
        {
            <div class="bg-white rounded shadow p-6 mb-6">
                <div class="flex justify-between items-start mb-4">
                    <div>
                        <h1 class="text-xl font-bold">@reservation.AppartementAdresse</h1>
                        <p class="text-gray-500 text-sm">
                            Du @reservation.DateArrivee.ToShortDateString() au @reservation.DateDepart.ToShortDateString()
                        </p>
                    </div>
                    <span class="@ClasseBadge text-xs px-3 py-1 rounded-full">@reservation.Statut</span>
                </div>

                <div class="grid grid-cols-2 gap-4 text-sm">
                    <div>
                        <p class="text-gray-500">Montant total</p>
                        <p class="font-semibold">@reservation.MontantTotal.ToString("N0") GNF</p>
                    </div>
                    <div>
                        <p class="text-gray-500">Déjà payé</p>
                        <p class="font-semibold">@reservation.MontantPaye.ToString("N0") GNF</p>
                    </div>
                </div>
            </div>

            @if (reservation.Statut == "EnAttente" && AuthSvc.UtilisateurId == reservation.LocataireId)
            {
                var restant = reservation.MontantTotal - reservation.MontantPaye;
                <div class="bg-white rounded shadow p-6">
                    <h3 class="font-semibold mb-3">Payer @restant.ToString("N0") GNF restants</h3>
                    <EditForm Model="@paiement" OnValidSubmit="Payer">
                        <label class="text-sm font-medium text-gray-700">Montant (GNF)</label>
                        <InputNumber @bind-Value="paiement.Montant"
                                     class="w-full border border-gray-300 rounded px-4 py-3 mt-1 mb-4 text-sm" />

                        <label class="text-sm font-medium text-gray-700">Mode de paiement</label>
                        <InputText @bind-Value="paiement.ModePaiement" placeholder="Orange Money, Espèces..."
                                   class="w-full border border-gray-300 rounded px-4 py-3 mt-1 mb-4 text-sm" />

                        <label class="text-sm font-medium text-gray-700">Référence (optionnel)</label>
                        <InputText @bind-Value="paiement.Reference"
                                   class="w-full border border-gray-300 rounded px-4 py-3 mt-1 mb-4 text-sm" />

                        <button type="submit"
                                class="w-full bg-immo-gold text-immo-dark font-semibold py-3 rounded hover:opacity-90">
                            Payer
                        </button>
                    </EditForm>
                    @if (!string.IsNullOrEmpty(messagePaiement))
                    {
                        <p class="text-sm mt-3">@messagePaiement</p>
                    }
                </div>
            }
            else if (reservation.Statut == "Confirmee")
            {
                <p class="text-green-700 text-sm">✓ Réservation entièrement payée et confirmée.</p>
            }
        }
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private ReservationDto? reservation;
    private bool chargement = true;
    private string? erreur;

    private PaiementModele paiement = new();
    private string? messagePaiement;

    private string ClasseBadge => reservation?.Statut switch
    {
        "Confirmee" => "bg-green-100 text-green-700",
        "Annulee" => "bg-red-100 text-red-700",
        _ => "bg-immo-dark/10 text-immo-dark"
    };

    protected override async Task OnInitializedAsync()
    {
        await AuthSvc.ChargerTokenAsync();
        paiement.ReservationId = Id;
        await Charger();
    }

    private async Task Charger()
    {
        chargement = true;
        try
        {
            var reponse = await Http.GetAsync($"reservation/{Id}");
            if (reponse.IsSuccessStatusCode)
            {
                reservation = await reponse.Content.ReadFromJsonAsync<ReservationDto>();
                paiement.Montant = (reservation!.MontantTotal - reservation.MontantPaye);
            }
            else
            {
                erreur = $"Erreur {(int)reponse.StatusCode} lors du chargement.";
            }
        }
        catch (Exception ex)
        {
            erreur = $"Erreur : {ex.Message}";
        }
        finally
        {
            chargement = false;
        }
    }

    private async Task Payer()
    {
        try
        {
            var reponse = await Http.PostAsJsonAsync("paiement/enregistrer", paiement);
            if (reponse.IsSuccessStatusCode)
            {
                messagePaiement = "Paiement enregistré.";
                await Charger();
            }
            else
            {
                messagePaiement = $"Erreur : {await reponse.Content.ReadAsStringAsync()}";
            }
        }
        catch (Exception ex)
        {
            messagePaiement = $"Erreur : {ex.Message}";
        }
    }
}
