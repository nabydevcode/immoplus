@page "/login"
@inject AuthServices AuthSvc
@inject NavigationManager Navigation

<PageTitle>Connexion - ImmoPlus</PageTitle>

<div class="bg-immo-dark px-6 py-3 flex justify-end">
    <NavLink href="" class="text-immo-cream text-sm border border-gray-600 px-4 py-2 rounded">
        ← Retour à l'accueil
    </NavLink>
</div>

<div class="min-h-screen bg-white flex items-center justify-center px-6 py-12">
    <div class="flex flex-col md:flex-row max-w-4xl w-full rounded-lg overflow-hidden shadow-lg">

        <div class="bg-immo-dark text-immo-cream p-10 md:w-1/2 flex flex-col justify-center gap-8">
            <div>
                <h2 class="text-immo-gold text-2xl font-bold mb-1">ImmoPlus</h2>
                <p class="text-gray-400 text-sm">La plateforme immobilière de référence</p>
            </div>

            <div class="flex gap-3">
                <div class="w-6 h-6 rounded-full bg-gray-700 flex items-center justify-center flex-shrink-0 mt-1">
                    <span class="w-2 h-2 bg-immo-gold rounded-full"></span>
                </div>
                <div>
                    <p class="font-semibold">Deux parcours</p>
                    <p class="text-gray-400 text-sm">Location longue durée avec dossier, ou séjour court sans dossier.</p>
                </div>
            </div>

            <div class="flex gap-3">
                <div class="w-6 h-6 rounded-full bg-gray-700 flex items-center justify-center flex-shrink-0 mt-1">
                    <span class="w-2 h-2 bg-immo-gold rounded-full"></span>
                </div>
                <div>
                    <p class="font-semibold">Financement disponible</p>
                    <p class="text-gray-400 text-sm">Avance de loyer remboursable en mensualités.</p>
                </div>
            </div>
        </div>

        <div class="p-10 md:w-1/2 flex flex-col justify-center bg-white">
            <h2 class="text-2xl font-bold mb-1">Bon retour</h2>
            <p class="text-gray-500 text-sm mb-6">Connectez-vous à votre espace personnel</p>

            <EditForm Model="@modele" OnValidSubmit="SeConnecter">
                <label class="text-sm font-medium text-gray-700">Adresse email</label>
                <InputText @bind-Value="modele.Email" placeholder="jean@example.com"
                           class="w-full border border-gray-300 rounded px-4 py-3 mt-1 mb-4 text-sm" />

                <label class="text-sm font-medium text-gray-700">Mot de passe</label>
                <InputText type="password" @bind-Value="modele.MotDePasse"
                           class="w-full border border-gray-300 rounded px-4 py-3 mt-1 text-sm" />

                <button type="submit"
                        class="w-full bg-immo-gold text-immo-dark font-semibold py-3 rounded hover:opacity-90 mt-6">
                    Se connecter
                </button>
            </EditForm>

            @if (!string.IsNullOrEmpty(messageErreur))
            {
                <p class="text-red-600 text-sm mt-4">@messageErreur</p>
            }

            <div class="border-t mt-6 pt-4 text-center text-sm">
                Pas encore de compte ?
                <NavLink href="inscription" class="text-immo-gold font-semibold">Créer un compte</NavLink>
            </div>
        </div>

    </div>
</div>

@code {
    private ConnexionModele modele = new();
    private string? messageErreur;

    private async Task SeConnecter()
    {
        var succes = await AuthSvc.ConnexionAsync(modele.Email, modele.MotDePasse);

        if (succes)
        {
            Navigation.NavigateTo("/");
        }
        else
        {
            messageErreur = "Email ou mot de passe incorrect.";
        }
    }

    public class ConnexionModele
    {
        public string Email { get; set; } = "";
        public string MotDePasse { get; set; } = "";
    }
}
