@page "/utilisateurs"
@inject HttpClient Http
@inject AuthServices AuthSvc

<PageTitle>Utilisateurs - ImmoPlus</PageTitle>

<div class="bg-immo-cream min-h-screen px-6 py-8">
    <h1 class="text-2xl font-bold mb-1">Utilisateurs</h1>
    <p class="text-gray-500 text-sm mb-6">Comptes inscrits sur la plateforme — validez ou refusez les nouvelles inscriptions.</p>

    @if (!AuthSvc.EstConnecte || AuthSvc.RoleUtilisateur != "Admin")
    {
        <p class="text-red-600 text-sm">Réservé aux administrateurs.</p>
    }
    else if (chargement)
    {
        <p>Chargement...</p>
    }
    else if (erreur is not null)
    {
        <p class="text-red-600">@erreur</p>
    }
    else if (utilisateurs is not null && utilisateurs.Count > 0)
    {
        <div class="bg-white rounded shadow overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="bg-immo-dark text-immo-cream text-left">
                        <th class="px-4 py-3">Nom</th>
                        <th class="px-4 py-3">Email</th>
                        <th class="px-4 py-3">Téléphone</th>
                        <th class="px-4 py-3">Rôle</th>
                        <th class="px-4 py-3">Statut</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in utilisateurs)
                    {
                        <tr class="border-b last:border-0">
                            <td class="px-4 py-3 font-medium">@u.Nom</td>
                            <td class="px-4 py-3 text-gray-600">@u.Email</td>
                            <td class="px-4 py-3 text-gray-600">@u.Telephone</td>
                            <td class="px-4 py-3">
                                <span class="bg-immo-dark/10 text-xs px-3 py-1 rounded-full">@u.Role</span>
                            </td>
                            <td class="px-4 py-3">
                                <span class="@ClasseBadge(u.Statut) text-xs px-3 py-1 rounded-full">@u.Statut</span>
                            </td>
                            <td class="px-4 py-3">
                                @if (u.Statut == "EnAttente")
                                {
                                    <div class="flex gap-2">
                                        <button @onclick="() => Valider(u.Id)"
                                                class="bg-immo-gold text-immo-dark text-xs font-semibold px-3 py-1.5 rounded">
                                            Valider
                                        </button>
                                        <button @onclick="() => Refuser(u.Id)"
                                                class="border border-red-400 text-red-600 text-xs font-semibold px-3 py-1.5 rounded">
                                            Refuser
                                        </button>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <p class="text-sm mt-4">@message</p>
        }
    }
    else
    {
        <p>Aucun utilisateur trouvé.</p>
    }
</div>

@code {
    private List<UtilisateurDto>? utilisateurs;
    private bool chargement = true;
    private string? erreur;
    private string? message;

    private static string ClasseBadge(string statut) => statut switch
    {
        "Valide" => "bg-green-100 text-green-700",
        "Refuse" => "bg-red-100 text-red-700",
        _ => "bg-amber-100 text-amber-700"
    };

    protected override async Task OnInitializedAsync()
    {
        var connecte = await AuthSvc.ChargerTokenAsync();
        if (!connecte || AuthSvc.RoleUtilisateur != "Admin")
        {
            chargement = false;
            return;
        }

        await Charger();
    }

    private async Task Charger()
    {
        chargement = true;
        try
        {
            var reponse = await Http.GetAsync("utilisateur/lister?page=1&taille=100");
            if (reponse.IsSuccessStatusCode)
            {
                var resultat = await reponse.Content.ReadFromJsonAsync<PagedResultDto<UtilisateurDto>>();
                utilisateurs = resultat?.Donnees;
            }
            else
            {
                erreur = $"Erreur {(int)reponse.StatusCode} : accès refusé ou problème serveur.";
            }
        }
        catch (Exception ex)
        {
            erreur = $"Erreur : {ex.Message}";
        }
        finally
        {
            chargement = false;
        }
    }

    private async Task Valider(int id)
    {
        var reponse = await Http.PostAsync($"utilisateur/{id}/valider", null);
        message = reponse.IsSuccessStatusCode ? "Utilisateur validé." : $"Erreur : {await reponse.Content.ReadAsStringAsync()}";
        await Charger();
    }

    private async Task Refuser(int id)
    {
        var reponse = await Http.PostAsync($"utilisateur/{id}/refuser", null);
        message = reponse.IsSuccessStatusCode ? "Utilisateur refusé." : $"Erreur : {await reponse.Content.ReadAsStringAsync()}";
        await Charger();
    }
}
