# Stockage objet Garage (compatible S3) — copier en infra/garage.env (non versionné, chmod 600),
# ou plus simple : ./infra/initialiser-secrets.sh (génère toutes les valeurs aléatoires, sans les afficher).
# Lu par : garage (démon), garage-init (création du bucket et des clés), sauvegarde-fichiers (clé lecture seule).
# Jamais transmis à l'API.
#
# Secret du réseau interne de Garage :          openssl rand -hex 32
GARAGE_RPC_SECRET=a-remplir
# Jeton de l'API d'administration (port 3903, interne au réseau Docker) :  openssl rand -hex 32
GARAGE_ADMIN_TOKEN=a-remplir
# Jeton des métriques Prometheus (/metrics, interne) :  openssl rand -hex 32
GARAGE_METRICS_TOKEN=a-remplir
S3_BUCKET=immoplus
# Clé de sauvegarde, LECTURE SEULE sur le bucket (service sauvegarde-fichiers).
#   identifiant : GK + 24 caractères hexadécimaux   echo "GK$(openssl rand -hex 12)"
#   secret      : 64 caractères hexadécimaux        openssl rand -hex 32
SAUVEGARDE_S3_CLE_ACCES=a-remplir
SAUVEGARDE_S3_CLE_SECRETE=a-remplir
