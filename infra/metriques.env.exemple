# Jeton d'accès à /metriques des instances du profil « echelle » (et de la future production) — copier en
# infra/metriques.env (non versionné, chmod 600), ou ./infra/initialiser-secrets.sh.
# Lu par : api-echelle-1/2 (Metriques__Jeton : en-tête « Authorization: Bearer <jeton> » exigé sur /metriques)
#          et prometheus (profil « supervision », qui l'envoie à chaque collecte).
# L'API de développement (port 5107) ne lit pas ce fichier : /metriques y reste ouvert à la boucle locale et aux réseaux privés.
#   openssl rand -hex 32
Metriques__Jeton=a-remplir
