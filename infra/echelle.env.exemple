# Réglages des 2 instances « production » du profil echelle (docker compose --profile echelle up -d) — copier en
# infra/echelle.env (non versionné, chmod 600), ou ./infra/initialiser-secrets.sh.
#
# Clé de signature des jetons JWT, PARTAGÉE par les 2 instances (un jeton émis par l'une est accepté par l'autre).
# Jamais la clé publique d'appsettings.json :  openssl rand -base64 64 | tr -d '\n'
Jwt__Cle=a-remplir
