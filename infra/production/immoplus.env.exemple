# Modèle de /etc/immoplus/immoplus.env (configuration de PRODUCTION de l'API, lue par systemd : EnvironmentFile).
# Le vrai fichier n'est JAMAIS versionné : root:root, droits 600.
#   sudo nano /etc/immoplus/immoplus.env   puis   sudo systemctl restart immoplus-api
# Syntaxe systemd : CLE=valeur, une par ligne, sans espaces autour du « = », pas de guillemets nécessaires.
# Les « __ » remplacent les « : » des clés de appsettings.json (Jwt__Cle = Jwt:Cle).

# --- Base de données (PostgreSQL local, rôle « immoplus » non superutilisateur) ---
ConnectionStrings__Default=Host=127.0.0.1;Port=5432;Database=immoplus;Username=immoplus;Password=A_REMPLACER
# 1 instance sur un petit serveur : 20 connexions au plus (40 par défaut).
BaseDeDonnees__TaillePoolMax=20

# --- Jetons de connexion : clé NOUVELLE et secrète (>= 64 caractères aléatoires : openssl rand -base64 66 | tr -d '\n/+=') ---
# La clé de appsettings.json est publique sur GitHub : ne jamais la réutiliser. La changer déconnecte tout le monde.
Jwt__Cle=A_REMPLACER

# --- Adresse publique du site (liens dans les emails et SMS) et origines autorisées (CORS) ---
# Tant que HTTPS n'est pas actif : http://168.231.77.68:8081 ; ensuite https://immoplus.cloud
Frontend__Url=http://168.231.77.68:8081
Cors__OriginesAutorisees__0=https://immoplus.cloud
Cors__OriginesAutorisees__1=https://www.immoplus.cloud
Cors__OriginesAutorisees__2=http://immoplus.cloud
Cors__OriginesAutorisees__3=http://168.231.77.68:8081

# --- Fichiers : disque local (pas de S3, pas de Redis dans la version légère) ---
# Dossier réel, hors des dossiers de version (défaut sans ce réglage : « Storage » à côté du programme, d'où l'ancien lien).
Stockage__Mode=Disque
Stockage__Disque__Dossier=/var/lib/immoplus/storage
# Redis__Connexion vide = instance unique (compteurs et cache en mémoire).
Redis__Connexion=

# --- Sauvegardes pg_dump listées dans la page admin (faites par immoplus-sauvegarde.timer) ---
Sauvegardes__Dossier=/var/backups/immoplus/postgres

# --- Emails (boîte d'envoi, client MailKit) ---
# Hostinger : authentification obligatoire, identifiant = adresse complète, expéditeur = cette même adresse.
# Smtp__Securite : Auto (défaut : 465 -> SslImplicite, 587 -> StartTls, 25/1025 -> Aucune) | SslImplicite | StartTls | Aucune.
# Autre possibilité : Smtp__Port=587 et Smtp__Securite=StartTls.
# Smtp__Host vide : les emails sont conservés « EnAttente » dans la boîte d'envoi (rien n'est perdu) jusqu'à la configuration.
# Messages « Abandonne » d'avant : bouton « Relancer » de la page admin Messages sortants
# (POST /api/admin/messages-sortants/relancer?statut=Abandonne).
Smtp__Host=smtp.hostinger.com
Smtp__Port=465
Smtp__Securite=SslImplicite
Smtp__Utilisateur=noreply@mail.immoplus.cloud
# Mot de passe de la boîte noreply (hPanel Hostinger > Emails). Contient des guillemets, « \ », des espaces ou finit par
# des espaces : l'écrire entre guillemets doubles en échappant " et \ par \ (syntaxe systemd EnvironmentFile).
Smtp__MotDePasse=A_REMPLACER
Smtp__Expediteur=noreply@mail.immoplus.cloud
Smtp__NomExpediteur=ImmoPlus

# --- SMS et paiement mobile : désactivés tant qu'il n'y a ni fournisseur ni contrat marchand ---
Sms__Mode=Desactive
PaiementMobile__Mode=Desactive
#PaiementMobile__SecretWebhook=   (secret fort obligatoire le jour où le mode est activé)

# --- Tâches de fond (une seule instance) ---
Rappels__Actif=true
Maintenance__Actif=true

# --- HTTP : nginx termine HTTPS et parle à l'API en HTTP -> pas de redirection HTTPS dans l'API ---
RedirectionHttps__Actif=false

# --- Observabilité ---
Journaux__Format=Json
# Jeton exigé pour lire /metriques (jamais publié par nginx) : openssl rand -hex 32
Metriques__Jeton=A_REMPLACER
