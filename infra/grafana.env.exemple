# Compte administrateur de Grafana (profil « supervision », http://localhost:3000) — copier en infra/grafana.env
# (non versionné, chmod 600), ou ./infra/initialiser-secrets.sh. Pris en compte à la PREMIÈRE création du volume
# grafana-data ; ensuite, changer le mot de passe depuis Grafana (ou supprimer le volume).
#   openssl rand -base64 24
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=a-remplir
