  {
   "id": 2,
   "type": "stat",
   "title": "Requêtes / s",
   "description": "Toutes instances, hors /metriques et /sante.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-immoplus"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus-immoplus"
     },
     "refId": "A",
     "expr": "sum(rate(http_server_request_duration_seconds_count{job=~\"$job\", instance=~\"$instance\", http_route!~\"/metriques|/sante/.*\"}[$__rate_interval]))",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Latence p95 (toutes routes)",
   "description": "Objectif : < 0,5 s.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-immoplus"
   },
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus-immoplus"
     },
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=~\"$job\", instance=~\"$instance\", http_route!~\"/metriques|/sante/.*\"}[$__rate_interval])))",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.3
       },
       {
        "color": "red",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Erreurs (5xx, 499)",
   "description": "Part des réponses 5xx + 499. Objectif : < 1 %. Base saturée = 503 avec Retry-After (depuis le 22/10/2026 ; avant : 400, d'où l'ancien comptage des 400, retiré) ; 499 = client parti avant la réponse (délai dépassé). Détail par code : panneau « Réponses par code HTTP ».",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus-immoplus"
   },
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus-immoplus"
     },
     "refId": "A",
     "expr": "(sum(rate(http_server_request_duration_seconds_count{job=~\"$job\", instance=~\"$instance\", http_route!~\"/metriques|/sante/.*\", http_response_status_code=~\"5..|499\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_server_request_duration_seconds_count{job=~\"$job\", instance=~\"$instance\", http_route!~\"/metriques|/sante/.*\"}[$__rate_interval])), 1e-9)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.005
       },
       {
        "color": "red",
        "value": 0.01
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value",
    "graphMode": "area"
   }
  },
