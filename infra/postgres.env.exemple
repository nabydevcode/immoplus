# Base PostgreSQL locale (Docker Compose). Copier ce fichier en infra/postgres.env (non versionné),
# remplacer les DEUX occurrences de a-remplir par le même mot de passe aléatoire, puis : docker compose up -d
# Générer un mot de passe :  openssl rand -hex 24
# Droits conseillés : chmod 600 infra/postgres.env
#
# Lu par les services postgres (création du compte au tout premier démarrage du volume),
# sauvegarde-db (pg_dump) et api (chaîne de connexion EF Core).
POSTGRES_PASSWORD=a-remplir
ConnectionStrings__Default=Host=postgres;Port=5432;Database=immoplus;Username=immoplus;Password=a-remplir

# Taille maximale du pool de connexions Npgsql PAR instance de l'API (40 par défaut, appsettings.json), appliquée si la
# chaîne ci-dessus ne contient pas déjà « Maximum Pool Size ». Règle : (nombre d'instances × pool) + sauvegardes + marge
# ≤ max_connections de PostgreSQL (150 en local, 100 par défaut ailleurs). En local, l'API de dev est forcée à 10 dans
# docker-compose.yml ; les instances du profil echelle gardent 40. Décommenter pour changer la valeur de toutes les API :
# BaseDeDonnees__TaillePoolMax=40
