# Stockage des fichiers de l'API (photos, miniatures, documents, états des lieux, pièces d'identité) — copier en
# infra/stockage.env (non versionné, chmod 600), ou ./infra/initialiser-secrets.sh.
# Lu par : api (et api-echelle-1/2), garage-init (qui crée la clé applicative avec ces valeurs).
#
# Disque = comportement historique (dossier Storage/ de l'API) ; S3 = bucket Garage.
# Ne passer à S3 qu'après la copie contrôlée des fichiers existants (outil du backend, voir README).
# Le profil « echelle » force S3 quoi qu'il y ait ici.
Stockage__Mode=Disque
Stockage__S3__Url=http://garage:9000
Stockage__S3__Bucket=immoplus
Stockage__S3__Region=us-east-1
Stockage__S3__CheminStyle=true
# Clé applicative : lecture + écriture sur le seul bucket immoplus, pas de création de bucket.
#   identifiant : GK + 24 caractères hexadécimaux   echo "GK$(openssl rand -hex 12)"
#   secret      : 64 caractères hexadécimaux        openssl rand -hex 32
Stockage__S3__CleAcces=a-remplir
Stockage__S3__CleSecrete=a-remplir
